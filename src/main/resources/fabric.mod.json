{
	"schemaVersion": 1,
	"id": "redstonelab",
	"version": "${version}",
	"name": "RedstoneLab",
	"description": "Redstone meters (timeline, exact pulse lengths, tick order) and Pistorder-style piston previews. No other mods needed besides Fabric API. Works on servers; players without the mod can use it too.",
	"authors": [
		"kyoubitt"
	],
	"contact": {},
	"license": "LGPL-3.0-only",
	"icon": "assets/redstonelab/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.redstonelab.RedstoneLab"
		],
		"client": [
			"dev.redstonelab.client.RedstoneLabClient"
		],
		"modmenu": [
			"dev.redstonelab.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"redstonelab.mixins.json",
		{
			"config": "redstonelab.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
